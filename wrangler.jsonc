{
	"$schema": "https://workers.cloudflare.com/schema/wrangler.json",
	"name": "flue-canvas",
	"compatibility_date": "2026-04-01",
	"compatibility_flags": ["nodejs_compat"],
	"migrations": [
		{
			"tag": "flue-class-FlueRegistry",
			"new_sqlite_classes": ["FlueRegistry"]
		},
		{
			"tag": "flue-class-CanvasTurnWorkflow",
			"new_sqlite_classes": ["CanvasTurnWorkflow"]
		}
	],
	"ai": {
		"binding": "AI"
	},
	"r2_buckets": [
		{
			"binding": "CANVAS_BUCKET",
			"bucket_name": "flue-canvas-bucket"
		}
	]
}
