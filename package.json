{
	"name": "flue-canvas",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "pnpm run build:client && vite dev",
		"build:client": "vite build --config vite.client.config.ts",
		"dev:client": "vite build --watch --config vite.client.config.ts",
		"build": "pnpm run build:client && vite build",
		"deploy": "pnpm run build && wrangler deploy",
		"check:types": "tsc --noEmit"
	},
	"dependencies": {
		"@flue/runtime": "^2.0.3",
		"@flue/sdk": "^2.0.3",
		"hono": "^4.12.32",
		"just-bash": "^3.4.2"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "1.49.0",
		"@cloudflare/workers-types": "5.20260731.1",
		"@flue/vite": "^2.0.3",
		"typescript": "^5.9.3",
		"vite": "^8.0.14",
		"wrangler": "4.116.0"
	},
	"pnpm": {
		"overrides": {
			"partyserver": "0.5.9"
		}
	}
}
